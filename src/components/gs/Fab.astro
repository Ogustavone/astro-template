---
import type { ImageMetadata } from "astro";

interface Link {
  href: string;
  icon: ImageMetadata | string;
  label?: string; // aria-label/tooltip
  newTab?: boolean;
  class?: string; // ex: "bg-green-500 hover:bg-green-600"
}

interface Props {
  links: Link[];
  class?: string;
}

const { links, class: className = "" } = Astro.props;

const src = (icon: Link["icon"]) =>
  typeof icon === "string" ? icon : icon.src;
const opensNewTab = ({ href, newTab }: Link) =>
  newTab ?? !/^(tel|mailto|sms):/.test(href);
---

<div
  class:list={["fixed right-5 bottom-5 z-50 flex flex-col gap-3", className]}
>
  {
    links.map((link) => (
      <a
        href={link.href}
        aria-label={link.label}
        title={link.label}
        target={opensNewTab(link) ? "_blank" : undefined}
        rel={opensNewTab(link) ? "noopener noreferrer" : undefined}
        class:list={[
          "flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12",
          "text-white rounded-full shadow-lg transition-transform",
          "active:scale-110 hover:scale-110",
          link.class ?? "bg-neutral-800",
        ]}
      >
        <span
          class="block w-6 h-6 bg-current"
          style={`-webkit-mask:url(${src(link.icon)}) center/contain no-repeat;mask:url(${src(link.icon)}) center/contain no-repeat;`}
        />
      </a>
    ))
  }
</div>
